// One Path Study 基幹運営アプリ (MVP) - Prisma schema
// 集団指導塾向け：クラス軸の出欠・演習提出管理 + 社内タスク・相談機能
//
// 実装メモ（提案書に明記のない項目についての判断）:
// - Student.status（在籍中/退会）: 提案書の生徒名簿項目には無いが、クラス編成・出欠管理を
//   実運用するには在籍状態の判別が必須なため追加した。
// - Class.level はマスタ化せず自由記述の文字列とした（クラス名で個別に識別されるため）。
// - ClassSession（クラスの実施回）は提案書に明示のない中間モデルだが、「クラスごとに出欠を
//   記録」するには実施日単位のレコードが必要なため追加した（同一クラス×同一日でユニーク）。
// - Task.dueDate（期限）は任意項目として追加（提案書に記載なし、一般的なタスク管理として妥当と判断）。
// - Consultation に返信スレッドは設けず、投稿+ステータス変更のみとした（ユーザー確認済み）。
// - Consultation.studentId は任意の生徒紐付けとした（ユーザー確認済み）。
// - Campus（校舎）は複数校舎対応の構造として最初から用意した（ユーザー確認済み）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER // 講師
  STAFF // 校舎スタッフ
  HQ // 本部社員
  EXECUTIVE // 役員
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ClassMode {
  ONLINE // オンライン
  OFFLINE // 対面
}

enum StudentStatus {
  ENROLLED // 在籍中
  WITHDRAWN // 退会
}

enum AttendanceStatus {
  PRESENT // 出席
  ABSENT // 欠席
  LATE // 遅刻
  EXCUSED // 公欠
}

enum TaskStatus {
  TODO // 未対応
  IN_PROGRESS // 対応中
  DONE // 完了
}

enum ConsultationStatus {
  UNHANDLED // 未対応
  IN_PROGRESS // 対応中
  RESOLVED // 対応済み
}

model Campus {
  id   String @id @default(cuid())
  name String @unique

  users    User[]
  students Student[]
  classes  Class[]

  createdAt DateTime @default(now())
}

model User {
  id                 String   @id @default(cuid())
  employeeNumber     String   @unique
  name               String
  passwordHash       String
  role               Role
  campusId           String?
  campus             Campus?  @relation(fields: [campusId], references: [id])
  mustChangePassword Boolean  @default(true)

  taughtClasses         Class[]        @relation("TeacherClasses")
  assignedTasks         Task[]         @relation("TaskAssignee")
  createdTasks          Task[]         @relation("TaskCreator")
  postedConsultations   Consultation[] @relation("ConsultationPoster")
  assignedConsultations Consultation[] @relation("ConsultationAssignee")
  recordedAttendances   Attendance[]   @relation("AttendanceRecordedBy")
  recordedSubmissions   Submission[]   @relation("SubmissionRecordedBy")
  recordedInterviews    Interview[]    @relation("InterviewRecordedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id   String @id @default(cuid())
  name String @unique

  students Student[]
  classes  Class[]

  createdAt DateTime @default(now())
}

model Student {
  id             String        @id @default(cuid())
  studentNumber  String        @unique
  name           String
  targetSchool   String?
  subjects       Subject[]
  enrolledAt     DateTime?
  parentContact  String?
  campusId       String?
  campus         Campus?       @relation(fields: [campusId], references: [id])
  status         StudentStatus @default(ENROLLED)

  classEnrollments ClassEnrollment[]
  interviews       Interview[]
  consultations    Consultation[]
  attendances      Attendance[]
  submissions      Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id        String    @id @default(cuid())
  name      String
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  level     String
  teacherId String
  teacher   User      @relation("TeacherClasses", fields: [teacherId], references: [id])
  weekday   Weekday
  startTime String
  endTime   String
  mode      ClassMode
  campusId  String?
  campus    Campus?   @relation(fields: [campusId], references: [id])

  enrollments ClassEnrollment[]
  sessions    ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassEnrollment {
  id         String   @id @default(cuid())
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([classId, studentId])
}

model ClassSession {
  id      String   @id @default(cuid())
  classId String
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date    DateTime

  attendances Attendance[]
  submissions Submission[]

  createdAt DateTime @default(now())

  @@unique([classId, date])
}

model Attendance {
  id             String           @id @default(cuid())
  classSessionId String
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus
  note           String?
  recordedById   String
  recordedBy     User             @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classSessionId, studentId])
}

model Submission {
  id             String       @id @default(cuid())
  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submitted      Boolean      @default(false)
  note           String?
  recordedById   String
  recordedBy     User         @relation("SubmissionRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classSessionId, studentId])
}

model Interview {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  content      String
  recordedById String
  recordedBy   User     @relation("InterviewRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  isRead      Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
}

model Consultation {
  id          String             @id @default(cuid())
  title       String
  content     String
  posterId    String
  poster      User               @relation("ConsultationPoster", fields: [posterId], references: [id])
  assigneeId  String
  assignee    User               @relation("ConsultationAssignee", fields: [assigneeId], references: [id])
  studentId   String?
  student     Student?           @relation(fields: [studentId], references: [id])
  status      ConsultationStatus @default(UNHANDLED)
  isRead      Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
}
