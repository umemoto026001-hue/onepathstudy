# PostgreSQL connection string. For local development, run a local Postgres
# (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=app -e POSTGRES_USER=app
# -e POSTGRES_DB=onepathstudy postgres:16`) or use a free hosted instance
# (Neon, Supabase, Vercel Postgres, etc.) and paste its connection string here.
DATABASE_URL="postgresql://app:app@localhost:5432/onepathstudy"

NEXTAUTH_SECRET="replace-with-a-random-secret"

# NEXTAUTH_URL is intentionally NOT set: auth.config.ts sets trustHost=true
# so the app infers its own URL from the incoming request. This lets local
# dev work on any port and lets Vercel preview/production deployments work
# without per-environment URL configuration. Only set NEXTAUTH_URL if you
# need to pin the app to one fixed canonical domain.
